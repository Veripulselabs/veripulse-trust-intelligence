    "/v1/trust-score/batch": {
      "post": {
        "tags": [
          "Trust Intelligence"
        ],
        "summary": "Batch Evaluate",
        "description": "High-throughput batch trust scoring for bulk signup audits.",
        "operationId": "batch_evaluate_v1_trust_score_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTrustScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchTrustScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/batch-score": {
      "post": {
        "tags": [
          "Trust Intelligence"
        ],
        "summary": "Batch Evaluate",
        "description": "High-throughput batch trust scoring for bulk signup audits.",
        "operationId": "batch_evaluate_v1_batch_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTrustScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchTrustScoreResponse"
                }
              }
            }
          },
          "422": {
