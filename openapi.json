{
  "openapi": "3.1.0",
  "info": {
    "title": "VeriPulse Trust Intelligence API",
    "description": "Unified Dual-Engine B2B Signup Fraud Defense & Bot Blocker by VeriPulse Labs. Synthesizes email deliverability and telecom carrier intelligence into an automated 0-100 Trust Score.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/trust-score": {
      "get": {
        "tags": [
          "Trust Intelligence"
        ],
        "summary": "Evaluate Trust Score",
        "description": "Unified Signup Fraud Defense & Bot Detection Endpoint.\nEvaluates email and phone signals concurrently to return a single 0-100 Trust Score.",
        "operationId": "evaluate_trust_score_v1_trust_score_get",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Email address to evaluate",
              "title": "Email"
            },
            "description": "Email address to evaluate"
          },
          {
            "name": "phone",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Phone number to evaluate",
              "title": "Phone"
            },
            "description": "Phone number to evaluate"
          },
          {
            "name": "country_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default ISO country code for phone validation",
              "default": "US",
              "title": "Country Code"
            },
            "description": "Default ISO country code for phone validation"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/TrustScoreRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrustScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Trust Intelligence"
        ],
        "summary": "Evaluate Trust Score",
        "description": "Unified Signup Fraud Defense & Bot Detection Endpoint.\nEvaluates email and phone signals concurrently to return a single 0-100 Trust Score.",
        "operationId": "evaluate_trust_score_v1_trust_score_post",
        "parameters": [
